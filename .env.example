# Copy this file to `.env` on the server and edit the values before starting Docker Compose.

# Use a long random value in production:
# openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-secret

# Admin account created by `pnpm db:seed` during container startup.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-secure-admin-password
ADMIN_NAME=Admin

# Direct Docker access example:
WEB_ORIGIN=http://localhost:9000
WEB_PORT=9000
COOKIE_SECURE=false

# If you deploy behind HTTPS, use values like:
# WEB_ORIGIN=https://your-domain.com
# WEB_PORT=9000
# COOKIE_SECURE=true
